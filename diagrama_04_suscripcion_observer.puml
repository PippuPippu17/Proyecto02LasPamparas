@startuml Diagrama_04_Suscripcion_Observer
title SECUENCIA 4: SUSCRIPCIÓN A NOTIFICACIONES (Observer)
skinparam backgroundColor #FEFEFE

actor Usuario
participant "Vista" as Vista
participant "ControladorPuestos" as Ctrl
participant "GestorPuestos" as Gestor
participant "PuestoComida\n<<Sujeto>>" as Puesto
participant "Usuario\n<<Observador>>" as Observador

Usuario -> Vista: Opción 7:\nSuscribirse a notificaciones

activate Vista

Vista -> Usuario: Ingresa tu nombre
Usuario --> Vista: "Juan"

Vista -> Usuario: Ingresa ID del puesto
Usuario --> Vista: "1"

Vista -> Ctrl: suscribirUsuario("Juan", "1")
activate Ctrl

Ctrl -> Gestor: buscarPorId("1")
activate Gestor

Gestor -> Gestor: puestos.stream()\n  .filter(p -> p.getId().equals("1"))\n  .findFirst()

Gestor --> Ctrl: Optional<PuestoComida>
deactivate Gestor

Ctrl -> Observador: new Usuario("Juan")
activate Observador
Observador --> Ctrl: observador
deactivate Observador

Ctrl -> Puesto: suscribir(observador)
activate Puesto

Puesto -> Puesto: observadores.add(observador)
Puesto -> Puesto: System.out.println("Usuario se ha suscrito")

Puesto --> Ctrl: void
deactivate Puesto

Ctrl --> Vista: true
deactivate Ctrl

Vista --> Usuario: ¡Suscripción exitosa!\nRecibirás notificaciones
deactivate Vista

== Más tarde: Cambio de Estado ==

participant "ActualizadorEstados\n<<Thread>>" as Actualizador

Actualizador -> Gestor: actualizarEstados(LocalTime.now())
activate Gestor

loop Para cada puesto
    Gestor -> Puesto: actualizarEstadoPorHora(hora)
    activate Puesto

    Puesto -> Puesto: Determinar nuevo estado

    alt Estado cambió
        Puesto -> Puesto: cambiarEstado(nuevoEstado)
        Puesto -> Puesto: notificar("El puesto ahora está: Abierto")

        loop Para cada observador
            Puesto -> Observador: actualizar(this, notificacion)
            activate Observador
            Observador -> Observador: System.out.println(\n  "[NOTIFICACION] [" + nombre + "] " +\n  puesto.getNombre() + ": " + notificacion)
            Observador --> Puesto: void
            deactivate Observador
        end
    end

    Puesto --> Gestor: void
    deactivate Puesto
end

Gestor --> Actualizador: void
deactivate Gestor

@enduml
