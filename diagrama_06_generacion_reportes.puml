@startuml Diagrama_06_Generacion_Reportes
title SECUENCIA 6: GENERACIÓN DE REPORTES
skinparam backgroundColor #FEFEFE

actor Usuario
participant "Vista" as Vista
participant "GeneradorReportes" as Reportes
participant "PuestoComida" as Puesto

Usuario -> Vista: Opción 8:\nGenerar reporte

activate Vista

Vista -> Usuario: Formato?\n1. TXT\n2. CSV
Usuario --> Vista: 1 (TXT)

Vista -> Reportes: generarReporteTXT(puestos, "reporte_puestos.txt")
activate Reportes

Reportes -> Reportes: BufferedWriter(\n  FileWriter("reporte_puestos.txt"))

Reportes -> Reportes: write(encabezado)
note right
========================================
   REPORTE DE PUESTOS DE COMIDA
========================================
Fecha: 20/11/2025 14:30:00
Total de puestos: 25
========================================
end note

loop Para cada PuestoComida
    Reportes -> Puesto: getId(), getNombre(), getTipo(), etc.
    activate Puesto

    Puesto --> Reportes: datos
    deactivate Puesto

    Reportes -> Reportes: write(formato de puesto)
    note right
    ID: 1
    Nombre: Chilaquiles
    Tipo: Comida Rapida
    Ubicación: Media Luna
    Precio: $50.00
    Estado: Abierto
    Horario: 08:00 - 18:00
    Métodos de pago: Efectivo|Transferencia
    ----------------------------------------
    end note
end

Reportes -> Reportes: close()

Reportes --> Vista: void
deactivate Reportes

Vista -> Reportes: escribirLog("Reporte TXT generado", "actividad.log")
activate Reportes

Reportes -> Reportes: FileWriter(append=true)
Reportes -> Reportes: write("[2025-11-20 14:30:00] Reporte TXT generado\n")

Reportes --> Vista: void
deactivate Reportes

Vista --> Usuario: ✓ Reporte generado:\nreporte_puestos.txt
deactivate Vista

@enduml
