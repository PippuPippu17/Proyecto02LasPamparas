@startuml Diagrama_02_Mostrar_Zonas_Composite
title SECUENCIA 2: MOSTRAR PUESTOS POR ZONAS (Composite)
skinparam backgroundColor #FEFEFE

actor Usuario
participant "Vista" as Vista
participant "ControladorPuestos" as Ctrl
participant "GestorPuestos" as Gestor
participant "Zona\n(Composite)" as Zona
participant "PuestoHoja\n(Leaf)" as Hoja
participant "PuestoComida" as Puesto

Usuario -> Vista: Selecciona opción 2:\nMostrar por zonas

activate Vista

Vista -> Ctrl: mostrarPorZonas()
activate Ctrl

Ctrl -> Gestor: crearEstructuraZonas()
activate Gestor

== Creación de Estructura Composite ==

Gestor -> Zona: new Zona("Facultad de Ciencias")
activate Zona

Gestor -> Zona: new Zona("Media Luna")
Gestor -> Zona: new Zona("Comedor")
Gestor -> Zona: new Zona("Estacionamiento")
Gestor -> Zona: new Zona("Puestos Exteriores")
Gestor -> Zona: new Zona("Edificios")

loop Para cada PuestoComida
    Gestor -> Hoja: new PuestoHoja(puesto)
    activate Hoja

    alt puesto.ubicacion == "Media Luna"
        Gestor -> Zona: mediaLuna.agregar(hoja)
    else puesto.ubicacion == "Comedor"
        Gestor -> Zona: comedor.agregar(hoja)
    else puesto.ubicacion == "Estacionamiento"
        Gestor -> Zona: estacionamiento.agregar(hoja)
    else otras ubicaciones
        Gestor -> Zona: zona.agregar(hoja)
    end

    deactivate Hoja
end

Gestor -> Zona: facultad.agregar(mediaLuna)
Gestor -> Zona: facultad.agregar(comedor)
Gestor -> Zona: facultad.agregar(estacionamiento)
note right: Composición de zonas

Gestor --> Ctrl: facultad
deactivate Gestor

== Mostrado Recursivo ==

Ctrl -> Zona: mostrar()

Zona -> Zona: System.out.println("=== ZONA: " + nombre)
Zona -> Zona: contarPuestos() [recursivo]

loop Para cada ComponenteZona
    Zona -> Zona: componente.mostrar()

    alt componente es Zona
        note right: Llamada recursiva
        Zona -> Zona: mostrar()
    else componente es PuestoHoja
        Zona -> Hoja: mostrar()
        activate Hoja
        Hoja -> Puesto: mostrarInfo()
        activate Puesto
        Puesto --> Hoja: void
        deactivate Puesto
        Hoja --> Zona: void
        deactivate Hoja
    end
end

Zona --> Ctrl: void
deactivate Zona

Ctrl --> Vista: void
deactivate Ctrl

Vista --> Usuario: Muestra estructura jerárquica
deactivate Vista

@enduml
