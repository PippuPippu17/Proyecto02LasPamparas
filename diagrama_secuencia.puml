Usuario --> Vista: "1"

Vista -> Ctrl: suscribirUsuario("Juan", "1")
activate Ctrl

Ctrl -> Gestor: buscarPorId("1")
activate Gestor

Gestor -> Gestor: puestos.stream()\n  .filter(p -> p.getId().equals("1"))\n  .findFirst()

Gestor --> Ctrl: Optional<PuestoComida>
deactivate Gestor

Ctrl -> Observador: new Usuario("Juan")
activate Observador
Observador --> Ctrl: observador
deactivate Observador

Ctrl -> Puesto: suscribir(observador)
activate Puesto

Puesto -> Puesto: observadores.add(observador)
Puesto -> Puesto: System.out.println("Usuario se ha suscrito")

