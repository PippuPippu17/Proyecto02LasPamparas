actor Usuario
participant "Vista" as Vista
participant "ControladorPuestos" as Ctrl
participant "GestorPuestos" as Gestor
participant "PuestoComida\n<<Sujeto>>" as Puesto
participant "Usuario\n<<Observador>>" as Observador

Usuario -> Vista: Opción 7:\nSuscribirse a notificaciones

