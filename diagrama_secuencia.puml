@startuml Diagrama_Secuencia_Completo_TeoremaDelSabor
title Diagrama de Secuencia Completo - Teorema del Sabor\nSistema de Gestión de Puestos de Comida

' ============================================================================
' SECUENCIA 1: INICIO DE LA APLICACIÓN
' ============================================================================

actor Usuario
participant "Main" as Main
participant "GestorPuestos" as Gestor
participant "AlmacenPuestos" as Almacen
participant "PuestoFactory" as Factory
participant "ControladorPuestos" as Controlador
participant "ServidorNotificaciones" as Servidor
participant "ActualizadorEstados" as Actualizador
participant "ServicioClima" as Clima
participant "VentanaPrincipal" as GUI
participant "Vista" as VistaConsola

Usuario -> Main: ejecutar programa

activate Main

== Inicialización del Sistema ==

Main -> Gestor: new GestorPuestos()
activate Gestor

Gestor -> Almacen: cargarPuestos()
activate Almacen

alt Archivo no existe o está vacío
    Almacen -> Almacen: crearArchivoPorDefecto()
    note right: Crea 25 puestos de ejemplo
end

Almacen -> Almacen: BufferedReader(data/puestos.txt)
loop Para cada línea del archivo
    Almacen -> Almacen: split(";")
    Almacen -> Factory: crearPuesto(Map<datos>)
    activate Factory
    Factory -> Factory: parsear campos
    Factory --> Almacen: new PuestoComida(...)
    deactivate Factory
end

Almacen --> Gestor: List<PuestoComida>
deactivate Almacen

Gestor --> Main: gestor
deactivate Gestor

Main -> Controlador: new ControladorPuestos(gestor)
activate Controlador
Controlador --> Main: controlador
deactivate Controlador

== Iniciar Servidor de Notificaciones (Sockets) ==

Main -> Servidor: new ServidorNotificaciones(8080)
activate Servidor
Main -> Servidor: start()
Servidor -> Servidor: Thread.run()
note right: Thread daemon escuchando en puerto 8080
Servidor -> Servidor: ServerSocket.accept()
note right: Espera conexiones de clientes
deactivate Servidor

== Iniciar Actualizador Automático (Threads) ==

Main -> Actualizador: new ActualizadorEstados(gestor, servidor, 60)
activate Actualizador
Main -> Actualizador: start()
Actualizador -> Actualizador: Thread.run()
note right: Thread daemon cada 60 segundos
deactivate Actualizador

== Consultar Clima Inicial (API Externa) ==

Main -> Clima: obtenerClimaInfo()
activate Clima

alt Caché válido (< 15 minutos)
    Clima --> Main: ClimaInfo (fromCache=true)
else Caché expirado o primera consulta
    Clima -> Clima: HttpURLConnection GET\nwttr.in/Mexico_City?format=j1
    Clima -> Clima: parseJson() con regex
    Clima -> Clima: generarRecomendacion()
    Clima -> Clima: guardar en caché
    Clima --> Main: ClimaInfo (fromCache=false)
end

deactivate Clima

Main -> Main: Runtime.addShutdownHook()
note right: Registra cierre limpio

== Selección de Interfaz ==

Main -> Usuario: ¿Qué interfaz deseas?\n1. GUI\n2. Consola

alt Usuario elige GUI
    Main -> GUI: SwingUtilities.invokeLater(\n  new VentanaPrincipal(controlador))
    activate GUI
    GUI -> GUI: inicializarComponentes()
    GUI -> GUI: cargarDatos()
    GUI -> GUI: actualizarClima() [async]
    GUI -> GUI: setVisible(true)
    note right: Interfaz gráfica Swing
    deactivate GUI

else Usuario elige Consola
    Main -> VistaConsola: new Vista(controlador)
    activate VistaConsola
    VistaConsola -> VistaConsola: menu()
    note right: Bucle while con opciones
    deactivate VistaConsola
end

deactivate Main

newpage SECUENCIA 2: MOSTRAR PUESTOS POR ZONAS (Composite)

actor Usuario
participant "Vista" as Vista
participant "ControladorPuestos" as Ctrl
participant "GestorPuestos" as Gestor
participant "Zona\n(Composite)" as Zona
participant "PuestoHoja\n(Leaf)" as Hoja
participant "PuestoComida" as Puesto

Usuario -> Vista: Selecciona opción 2:\nMostrar por zonas

activate Vista

Vista -> Ctrl: mostrarPorZonas()
activate Ctrl

Ctrl -> Gestor: crearEstructuraZonas()
activate Gestor

== Creación de Estructura Composite ==

Gestor -> Zona: new Zona("Facultad de Ciencias")
activate Zona

Gestor -> Zona: new Zona("Media Luna")
Gestor -> Zona: new Zona("Comedor")
Gestor -> Zona: new Zona("Estacionamiento")
Gestor -> Zona: new Zona("Puestos Exteriores")
Gestor -> Zona: new Zona("Edificios")

loop Para cada PuestoComida
    Gestor -> Hoja: new PuestoHoja(puesto)
    activate Hoja

    alt puesto.ubicacion == "Media Luna"
        Gestor -> Zona: mediaLuna.agregar(hoja)
    else puesto.ubicacion == "Comedor"
        Gestor -> Zona: comedor.agregar(hoja)
    else puesto.ubicacion == "Estacionamiento"
        Gestor -> Zona: estacionamiento.agregar(hoja)
    else otras ubicaciones
        Gestor -> Zona: zona.agregar(hoja)
    end

    deactivate Hoja
end

Gestor -> Zona: facultad.agregar(mediaLuna)
Gestor -> Zona: facultad.agregar(comedor)
Gestor -> Zona: facultad.agregar(estacionamiento)
note right: Composición de zonas

Gestor --> Ctrl: facultad
deactivate Gestor

== Mostrado Recursivo ==

Ctrl -> Zona: mostrar()

Zona -> Zona: System.out.println("=== ZONA: " + nombre)
Zona -> Zona: contarPuestos() [recursivo]

loop Para cada ComponenteZona
    Zona -> Zona: componente.mostrar()

    alt componente es Zona
        note right: Llamada recursiva
        Zona -> Zona: mostrar()
    else componente es PuestoHoja
        Zona -> Hoja: mostrar()
        activate Hoja
        Hoja -> Puesto: mostrarInfo()
        activate Puesto
        Puesto --> Hoja: void
        deactivate Puesto
        Hoja --> Zona: void
        deactivate Hoja
    end
end

Zona --> Ctrl: void
deactivate Zona

Ctrl --> Vista: void
deactivate Ctrl

Vista --> Usuario: Muestra estructura jerárquica
deactivate Vista

newpage SECUENCIA 3: RECOMENDACIÓN POR PRECIO (Strategy)

actor Usuario
participant "Vista" as Vista
participant "ControladorPuestos" as Ctrl
participant "GestorPuestos" as Gestor
participant "RecomendacionPrecio\n<<Strategy>>" as StrategyPrecio
participant "PuestoComida" as Puesto

Usuario -> Vista: Opción 4:\nRecomendar por precio

activate Vista

Vista -> Usuario: Ingresa precio máximo
Usuario --> Vista: 50.0

Vista -> StrategyPrecio: new RecomendacionPrecio(50.0)
activate StrategyPrecio
StrategyPrecio --> Vista: estrategia
deactivate StrategyPrecio

Vista -> Ctrl: recomendar(estrategia)
activate Ctrl

Ctrl -> Gestor: recomendar(estrategia)
activate Gestor

Gestor -> StrategyPrecio: recomendar(puestos)
activate StrategyPrecio

StrategyPrecio -> StrategyPrecio: puestos.stream()\n  .filter(p -> p.getPrecioPromedio() <= 50.0)\n  .collect(toList())

loop Para cada puesto en el stream
    StrategyPrecio -> Puesto: getPrecioPromedio()
    activate Puesto
    Puesto --> StrategyPrecio: precio
    deactivate Puesto

    alt precio <= 50.0
        note right: Incluir en resultado
    else precio > 50.0
        note right: Filtrar
    end
end

StrategyPrecio --> Gestor: List<PuestoComida> filtrados
deactivate StrategyPrecio

Gestor --> Ctrl: resultado
deactivate Gestor

loop Para cada puesto recomendado
    Ctrl -> Puesto: mostrarInfo()
    activate Puesto
    Puesto --> Ctrl: void
    deactivate Puesto
end

Ctrl --> Vista: void
deactivate Ctrl

Vista --> Usuario: Muestra puestos ≤ $50.0
deactivate Vista

