@startuml Diagrama_01_Inicio_Aplicacion
title SECUENCIA 1: INICIO DE LA APLICACIÓN
skinparam backgroundColor #FEFEFE
skinparam actorBackgroundColor #E8F4F8
skinparam participantBackgroundColor #E3F2FD

actor Usuario
participant "Main" as Main
participant "GestorPuestos" as Gestor
participant "AlmacenPuestos" as Almacen
participant "PuestoFactory" as Factory
participant "ControladorPuestos" as Controlador
participant "ServidorNotificaciones" as Servidor
participant "ActualizadorEstados" as Actualizador
participant "ServicioClima" as Clima
participant "VentanaPrincipal" as GUI
participant "Vista" as VistaConsola

Usuario -> Main: ejecutar programa

activate Main

== Inicialización del Sistema ==

Main -> Gestor: new GestorPuestos()
activate Gestor

Gestor -> Almacen: cargarPuestos()
activate Almacen

alt Archivo no existe o está vacío
    Almacen -> Almacen: crearArchivoPorDefecto()
    note right: Crea 25 puestos de ejemplo
end

Almacen -> Almacen: BufferedReader(data/puestos.txt)
loop Para cada línea del archivo
    Almacen -> Almacen: split(";")
    Almacen -> Factory: crearPuesto(Map<datos>)
    activate Factory
    Factory -> Factory: parsear campos
    Factory --> Almacen: new PuestoComida(...)
    deactivate Factory
end

Almacen --> Gestor: List<PuestoComida>
deactivate Almacen

Gestor --> Main: gestor
deactivate Gestor

Main -> Controlador: new ControladorPuestos(gestor)
activate Controlador
Controlador --> Main: controlador
deactivate Controlador

== Iniciar Servidor de Notificaciones (Sockets) ==

Main -> Servidor: new ServidorNotificaciones(8080)
activate Servidor
Main -> Servidor: start()
Servidor -> Servidor: Thread.run()
note right: Thread daemon escuchando en puerto 8080
Servidor -> Servidor: ServerSocket.accept()
note right: Espera conexiones de clientes
deactivate Servidor

== Iniciar Actualizador Automático (Threads) ==

Main -> Actualizador: new ActualizadorEstados(gestor, servidor, 60)
activate Actualizador
Main -> Actualizador: start()
Actualizador -> Actualizador: Thread.run()
note right: Thread daemon cada 60 segundos
deactivate Actualizador

== Consultar Clima Inicial (API Externa) ==

Main -> Clima: obtenerClimaInfo()
activate Clima

alt Caché válido (< 15 minutos)
    Clima --> Main: ClimaInfo (fromCache=true)
else Caché expirado o primera consulta
    Clima -> Clima: HttpURLConnection GET\nwttr.in/Mexico_City?format=j1
    Clima -> Clima: parseJson() con regex
    Clima -> Clima: generarRecomendacion()
    Clima -> Clima: guardar en caché
    Clima --> Main: ClimaInfo (fromCache=false)
end

deactivate Clima

Main -> Main: Runtime.addShutdownHook()
note right: Registra cierre limpio

== Selección de Interfaz ==

Main -> Usuario: ¿Qué interfaz deseas?\n1. GUI\n2. Consola

alt Usuario elige GUI
    Main -> GUI: SwingUtilities.invokeLater(\n  new VentanaPrincipal(controlador))
    activate GUI
    GUI -> GUI: inicializarComponentes()
    GUI -> GUI: cargarDatos()
    GUI -> GUI: actualizarClima() [async]
    GUI -> GUI: setVisible(true)
    note right: Interfaz gráfica Swing
    deactivate GUI

else Usuario elige Consola
    Main -> VistaConsola: new Vista(controlador)
    activate VistaConsola
    VistaConsola -> VistaConsola: menu()
    note right: Bucle while con opciones
    deactivate VistaConsola
end

deactivate Main

@enduml
